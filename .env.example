# Salin jadi .env lalu isi. File .env tidak ikut git.
#
# DUA JALUR AI:
#  1) Key sendiri (disarankan untuk pengguna umum): tiap pengguna menempel API key Gemini-nya di
#     app (Lainnya > Kategori AI). Tidak perlu server, tidak perlu isi apa pun di sini.
#  2) Server Arus (mode pribadi): isi GEMINI_API_KEY di bawah, jalankan `npm run server`, dan
#     nyalakan baris VITE_AI_SERVER=1. Key-mu tinggal di server, tidak pernah ke browser.
# VITE_AI_SERVER=1

GEMINI_API_KEY=
# Opsional. Kosongkan untuk bawaan (gemini-flash-latest = Flash terbaru, tidak basi):
# GEMINI_MODEL=

# --- Pengaman (aman dibiarkan default untuk pemakaian pribadi) ---
# Batas permintaan per IP per menit, dan total per hari:
AI_RATE_PER_MIN=20
AI_DAILY_LIMIT=300
# Kalau server ini bisa diakses dari internet: isi alamat situs Arus-mu supaya situs lain ditolak.
# ALLOWED_ORIGIN=https://arus.contohmu.com
# Isi 1 HANYA kalau server ada di belakang reverse proxy tepercaya (Nginx/Cloudflare):
# TRUST_PROXY=1
